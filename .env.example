# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your-watsonx-api-key-here
WATSONX_PROJECT_ID=your-project-id-here

# Model IDs (defaults match the reference notebook)
GRANITE_CODE_MODEL_ID=ibm/granite-4-h-small
GRANITE_VISION_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Optional access-token for API authentication
ACCESS_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────────
ARTIFACT_DIR=artifacts

# ── Research ──────────────────────────────────────────────────────────────────
# Leave SEARCH_API_KEY blank to use DuckDuckGo (no key required)
SEARCH_API_KEY=
SEARCH_PROVIDER=duckduckgo
RESEARCH_MAX_RESULTS=5

# ── Layout engine ─────────────────────────────────────────────────────────────
LAYOUT_NODE_WIDTH_CM=3.0
LAYOUT_NODE_HEIGHT_CM=1.2
LAYOUT_H_GAP_CM=2.6
LAYOUT_V_GAP_CM=1.8
LAYOUT_PADDING_CM=0.5
LAYOUT_CONTAINER_INNER_SEP_CM=0.6

# ── Compiler ──────────────────────────────────────────────────────────────────
LATEX_COMPILER=pdflatex
LATEX_FALLBACK_URL=https://texlive.net/cgi-bin/latexcgi
PREVIEW_DPI=220
MAX_REPAIR_ATTEMPTS=3

# ── Typography ────────────────────────────────────────────────────────────────
# Set USE_FONTSPEC=false if your environment does not have Times New Roman installed.
# In that case, mathptmx (pdflatex) is used as a closely matching substitute.
PREFERRED_FONT=Times New Roman
FALLBACK_FONT=TeX Gyre Termes
USE_FONTSPEC=false

# ── Redis (optional – for production async job queue) ─────────────────────────
REDIS_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_ACCESS_TOKEN=
